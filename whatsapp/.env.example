# Copia este archivo a ".env" y rellena tus datos reales.
# NUNCA subas el archivo .env con datos reales a GitHub (ya está en .gitignore).

# Token de acceso de la app de Meta (lo copias del panel de WhatsApp > API Setup)
WHATSAPP_TOKEN=pega_aqui_tu_token

# ID del número de teléfono de prueba (aparece en el mismo panel, "Phone number ID")
WHATSAPP_PHONE_NUMBER_ID=pega_aqui_el_id

# Versión de la API (puedes dejar esta)
WHATSAPP_API_VERSION=v21.0
